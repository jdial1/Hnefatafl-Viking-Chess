# Socket.IO server the packaged Android app connects to.
# The web build leaves this unset and uses the page origin instead.
#
# Android emulator reaching `npm run dev` on this machine: http://10.0.2.2:3000
# Physical device on the same Wi-Fi:                        http://<your-lan-ip>:3000
# Deployed server:                                          https://your-host
VITE_SOCKET_URL=http://10.0.2.2:3000
