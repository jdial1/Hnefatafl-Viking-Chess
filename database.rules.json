{
  "rules": {
    "presence": {
      ".read": true,
      "$id": {
        ".write": "auth != null"
      }
    },
    "queue": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null"
      }
    }
  }
}
