{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "queue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (!data.exists() || data.child('players').hasChild(auth.uid) || (data.child('status').val() === 'waiting' && data.child('players').hasChild(data.child('hostUid').val()) && !data.child('players').hasChild(auth.uid) && newData.child('players').hasChild(auth.uid)))"
      }
    }
  }
}
